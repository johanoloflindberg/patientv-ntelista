{
  "version": "1.0.0",
  "type": "module",
  "source": "./src/public-api.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/public-api.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/types/public-api.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "name": "anima-project",
  "description": "Reusable React UI components generated with Anima and Shadcn UI",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:package": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "verify:package": "npm run build:package && tsc -p verification/tsconfig.json --noEmit && vite build --config vite.verify.config.ts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.0",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-label": "^2.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@animaapp/vite-plugin-screen-graph": "^0.1.5",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "esbuild": "0.27.3",
    "globals": "15.15.0",
    "tailwindcss": "3.4.16",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "alias": {
    "@/*": "./src/components/ui/$1"
  }
}
